#!ipxe
# Some menu defaults
dhcp
imgfree

set menu-timeout 30000
set submenu-timeout ${menu-timeout}
isset ${menu-default} || set menu-default clonezilla
# Server configuration
set server-ip 192.168.1.1
set nas-ip ${server-ip}
set wimboot-url http://${server-ip}/wimboot

# Console a 1024x768 -> 128x48 caratteri (invece degli 80x25 di default EFI).
# Serve perche' il menu ha 21 righe (17 voci + 4 separatori) + titolo + indicatore
# di scroll = 23, mentre l'80x25 ne lascia ~20: "Exit iPXE" finiva in seconda pagina.
# Il "||" finale rende il comando best-effort:
#   - se il firmware rifiuta la modalita' video, si resta in 80x25 come prima
#   - sui client BIOS legacy (undionly.kpxe) il comando non esiste proprio, perche'
#     config/general.h fa #undef CONSOLE_CMD per PLATFORM_pcbios -> errore ignorato
# Richiede CONSOLE_FRAMEBUFFER (attivo in config/console.h) e console_cmd.o (linkato
# solo nel build EFI).
console --x 1024 --y 768 ||

:start
menu iPXE Boot Menu
item --gap --            ------------------------- Backup & Recovery -------------------------------
item --key k clonezilla  Clonezilla Live
item --key j clonezilla_jumbo  Clonezilla Live (jumbo MTU 9000)
item --key r rescuezilla Rescuezilla
item --key m macrium     Macrium Recovery Media
item --key s synomedia   Synology Recovery Media
item --gap --            ------------------------- System Tools & Diagnostics ----------------------
item --key 1 sysresccd   System Rescue CD
item --key h hirens      Hiren's BootCD PE
item --key 2 strelec10   Sergei Strelec WinPE 10
item --key 3 strelec11   Sergei Strelec WinPE 11
item --key p minitool    MiniTool Partition Wizard
item --key e easyuefi    EasyUEFI Enterprise
item --gap --            ------------------------- Network Boot & Install --------------------------
item --key i archiso     Arch Linux ISO (NAS)
item --key n netboot     netboot.xyz
item --gap --            ------------------------- Utility -----------------------------------------
item --key c config      Configure settings
item shell               Drop to iPXE shell
item reboot              Reboot
item --key x exit        Exit iPXE
choose --default ${menu-default} --timeout ${menu-timeout} selected || goto cancel
set menu-timeout 0
goto ${selected}

:cancel
echo You cancelled the menu, dropping you to a shell

:shell
echo Type 'exit' to get the back to the menu
shell
set menu-timeout 0
set submenu-timeout 0
goto start

:failed
echo Booting failed, dropping to shell
goto shell

:reboot
reboot

:exit
exit

:config
config
goto start

:back
set submenu-timeout 0
clear submenu-default
goto start

############ MAIN MENU ITEMS ############
:sysresccd
set base-url http://${server-ip}/sysresccd
kernel ${base-url}/vmlinuz initrd=intel_ucode.img,amd_ucode.img,sysresccd.img archisobasedir=/ ip=dhcp archiso_http_srv=${base-url}/ checksum setkmap=it
initrd ${base-url}/intel_ucode.img
initrd ${base-url}/amd_ucode.img
initrd ${base-url}/sysresccd.img
boot || goto failed

# Generic WinPE boot function
:boot_winpe
kernel ${wimboot-url}
initrd ${base-url}/boot/BCD         BCD
initrd ${base-url}/boot/boot.sdi    boot.sdi
initrd ${base-url}/sources/boot.wim boot.wim
boot || goto failed

# Generic WinPE boot function (lowercase bcd)
:boot_winpe_lower
kernel ${wimboot-url}
initrd ${base-url}/boot/bcd         BCD
initrd ${base-url}/boot/boot.sdi    boot.sdi
initrd ${base-url}/sources/boot.wim boot.wim
boot || goto failed

:macrium
set base-url http://${server-ip}/macrium
goto boot_winpe

:synomedia
set base-url http://${server-ip}/synomedia
goto boot_winpe

:minitool
set base-url http://${server-ip}/minitool
goto boot_winpe_lower

# Strelec WinPE boot function
# Injects network.cmd (WaitForNetwork + mounts Z: via SMB + original WIM logic)
# so that all FORX \SSTR\... find files on Z:\SSTR\ just like USB boot
:boot_strelec
kernel ${wimboot-url} || goto failed
initrd --name network.cmd ${base-url}/${strelec-netcmd} network.cmd || goto failed
initrd --name bootx64.efi ${base-url}/bootx64.efi bootx64.efi || goto failed
initrd --name bootmgr.exe ${base-url}/bootmgr64.exe bootmgr.exe || goto failed
initrd --name BCD ${base-url}/bcd BCD || goto failed
initrd --name boot.sdi ${base-url}/boot.sdi boot.sdi || goto failed
initrd --name boot.wim ${base-url}/SSTR/${strelec-wim} boot.wim || goto failed
boot || goto failed

:strelec10
set base-url http://${server-ip}/strelec
set strelec-wim strelec10x64Eng.wim
set strelec-netcmd network_10.cmd
goto boot_strelec

:strelec11
set base-url http://${server-ip}/strelec
set strelec-wim strelec11x64Eng.wim
set strelec-netcmd network_11.cmd
goto boot_strelec

:easyuefi
set base-url http://${server-ip}/easyuefi
kernel ${wimboot-url}
initrd ${base-url}/boot/bcd         BCD
initrd ${base-url}/boot/boot.sdi    boot.sdi
initrd ${base-url}/bootx64.efi bootx64.efi
initrd ${base-url}/bootmgr     bootmgr
initrd ${base-url}/sources/boot.wim boot.wim
boot || goto failed

:hirens
set base-url http://${server-ip}/hirens
kernel ${wimboot-url}
initrd ${base-url}/boot/bcd         BCD
initrd ${base-url}/boot/boot.sdi    boot.sdi
initrd ${base-url}/bootmgr.efi bootmgr.efi
initrd ${base-url}/bootmgr.exe bootmgr.exe
initrd ${base-url}/sources/boot.wim boot.wim
boot || goto failed

# net.ifnames=0 -> nomi interfaccia legacy (eth0) anche qui, per coerenza con
# :clonezilla_jumbo ed allineamento al default ufficiale Clonezilla live.
# Nessuna funzionalita' dipende dal nome (il mount NFS usa l'IP): e' solo
# prevedibilita' quando si diagnostica da Enter_shell. Verificato 2026-08-03:
# senza questo flag l'interfaccia era enp4s0.
:clonezilla
set base-url http://${server-ip}/clonezilla
kernel ${base-url}/vmlinuz initrd=initrd.img boot=live username=user union=overlay config components quiet noswap edd=on nomodeset net.ifnames=0 nodmraid keyboard-layouts=it locales=it_IT.UTF-8 fetch=${base-url}/filesystem.squashfs ocs_numlk=on ocs_daemonon="ssh" ocs_prerun="mount -t nfs ${nas-ip}:/volume2/backup /home/partimag"
initrd ${base-url}/initrd.img
boot || goto failed

# Variante jumbo frame: identica a :clonezilla ma alza la MTU a 9000 prima del
# mount NFS, per sfruttare i jumbo sul link 2.5G verso il NAS (~5% in piu').
#   - net.ifnames=0  -> nomi interfaccia legacy, garantisce "eth0" (e' anche il
#                       default ufficiale di Clonezilla live, assente in :clonezilla)
#   - ocs_prerun     -> alza la MTU; se fallisce, ocs_prerun1 monta comunque a 1500
#   - ocs_prerun1    -> mount NFS della destinazione (identico a :clonezilla)
# ATTENZIONE: usare SOLO su macchine dove i jumbo sono verificati end-to-end
#   (da shell Clonezilla: ip link set dev eth0 mtu 9000 && ping -M do -s 8972 192.168.1.1)
# Se la NIC accetta 9000 ma lo switch/porta non li inoltra, il mount NFS si pianta.
# Per il resto usare la voce :clonezilla standard (MTU 1500, sempre sicura).
:clonezilla_jumbo
set base-url http://${server-ip}/clonezilla
kernel ${base-url}/vmlinuz initrd=initrd.img boot=live username=user union=overlay config components quiet noswap edd=on nomodeset net.ifnames=0 nodmraid keyboard-layouts=it locales=it_IT.UTF-8 fetch=${base-url}/filesystem.squashfs ocs_numlk=on ocs_daemonon="ssh" ocs_prerun="ip link set dev eth0 mtu 9000" ocs_prerun1="mount -t nfs ${nas-ip}:/volume2/backup /home/partimag"
initrd ${base-url}/initrd.img
boot || goto failed

:rescuezilla
set base-url http://${server-ip}/rescuezilla
kernel ${base-url}/vmlinuz initrd=initrd.lz boot=casper quiet splash fastboot toram root=/dev/ram0 ramdisk_size=15000000 bootkbd=it console-setup/layoutcode=it ip=dhcp url=${base-url}/rescuezilla.iso
initrd ${base-url}/initrd.lz
boot || goto failed

:netboot
# Carica lo SCRIPT menu di netboot.xyz, non il binario .efi, per restare
# nel nostro iPXE (con driver tastiera USB usbkbd).
# "set version 3.x" supera il loro version-check, che altrimenti
# ri-chainloaderebbe il binario netboot.xyz-snponly.efi (senza usbkbd ->
# tastiera morta). E' lo stesso trucco che usa il loro binario ufficiale.
set version 3.x
chain --autofree https://boot.netboot.xyz/menu.ipxe || goto failed

# Arch Linux ISO locale dal NAS (archiso via HTTP).
# NB: il netboot Arch online si fa da netboot.xyz (rimossa la vecchia voce
# archlinux/ipxe-arch.efi e la relativa cartella sul NAS).
# Voce GENERICA: i percorsi/nomi file sono fissi tra le release archiso,
# quindi per aggiornare basta sovrascrivere i file in /volume1/web/archiso/
# sul NAS, senza ricompilare nas.efi. Versione corrente in archiso/VERSION.txt
:archiso
set base-url http://${server-ip}/archiso
kernel ${base-url}/arch/boot/x86_64/vmlinuz-linux initrd=initramfs-linux.img archiso_http_srv=${base-url}/ archisobasedir=arch checksum ip=dhcp net.ifnames=0 BOOTIF=01-${net0/mac:hexhyp}
initrd ${base-url}/arch/boot/x86_64/initramfs-linux.img
boot || goto failed
